# Copy to `.env.local` (gitignored). Only `VITE_*` keys are exposed to the browser.

# --- Supabase (required for sign-in + cloud sync) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional per-deployment OAuth return target. If unset, the app falls back to window.location.origin.
# VITE_AUTH_REDIRECT_URL=https://coach-royale.com

# --- Optional overrides (sensible defaults match production / local dev) ---
# API base for player, battles, etc. Default: http://localhost:8787/api in dev, https://relay.coach-royale.com/api in prod
# VITE_API_BASE_URL=http://localhost:8787/api

# --- Optional: Sentry error reporting (disabled by default) ---
# To enable error reporting to Sentry, set both:
# VITE_SENTRY_DSN=https://key@o12345.ingest.sentry.io/123456
# VITE_SENTRY_ENABLED=true
